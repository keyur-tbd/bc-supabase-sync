# ---- Business Central / Entra ID (OAuth2 client credentials) ----
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=
BC_COMPANY_ID=

# ---- BC fetch tuning ----
# Read timeout per page request (seconds). Heavy entities need headroom.
BC_REQUEST_TIMEOUT_SECONDS=300
# Server-driven page size (Prefer: odata.maxpagesize). Bounds each PAGE
# while keeping @odata.nextLink, so the full dataset is paged through.
# BC clamps this at 20000. Cost is bytes, not rows: 10000 rows of a narrow
# page is ~3 MB, 10000 rows of a wide document page is ~39 MB, and a page
# that times out is re-fetched whole. Most of the speed-up is already there
# at 5000; override per service with "max_page_size" in web_services.json.
BC_MAXPAGESIZE=5000
# Default trailing re-scan buffer (days) for date-based incremental syncs,
# to catch back-dated postings. Overridable per service in web_services.json.
BC_LOOKBACK_DAYS=7

# ---- Supabase (Postgres) ----
# EASIEST: paste the connection string from
#   Supabase Dashboard > Project Settings > Database > Connection string > URI
# and put your database password in place of [YOUR-PASSWORD].
# Both the direct connection (port 5432) and the transaction pooler
# (port 6543) work; see SUPABASE_USE_POOLER below.
#
# GOTCHA: this is a URI, so any of  : / ? # [ ] @ %  in the password MUST be
# percent-encoded, or it is parsed as URL structure and you get a confusing
# "password authentication failed for user postgres". A literal % becomes
# %25, @ becomes %40, # becomes %23. If in doubt, use the discrete
# SUPABASE_DB_* variables below instead - those are taken literally.
#   python -c "from urllib.parse import quote; print(quote(input(), safe=''))"
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ALTERNATIVE to SUPABASE_DB_URL: set the parts individually and leave
# SUPABASE_DB_URL empty.
# SUPABASE_DB_HOST=db.abcdefghijklm.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=

# Schema to sync into. "public" is exposed through the Supabase REST API;
# a dedicated schema (e.g. "bc") keeps the raw ETL tables off that surface.
SUPABASE_DB_SCHEMA=public

# Supabase requires TLS.
#
# GOTCHA: libpq treats sslmode=require as verify-ca IF a root CA file
# happens to exist on the machine - %APPDATA%\postgresql\root.crt on
# Windows, ~/.postgresql/root.crt elsewhere. A leftover file there causes
# "SSL error: certificate verify failed" on a perfectly correct connection
# string. If you hit that, set the two values below explicitly rather than
# deleting the file.
SUPABASE_DB_SSLMODE=require

# CA bundle used to verify the server certificate. Either:
#   system                    - use the OS trust store (works when the
#                               endpoint uses a publicly-trusted CA)
#   C:/path/to/prod-ca.crt    - the certificate downloaded from
#                               Supabase Dashboard > Project Settings >
#                               Database > SSL Configuration
# Pair either with SUPABASE_DB_SSLMODE=verify-full for a properly verified
# connection. Leave blank to let libpq decide (see the gotcha above).
SUPABASE_DB_SSLROOTCERT=

# Disables server-side prepared statements, which Supabase's transaction
# pooler (port 6543, PgBouncer) does not support. Safe to leave true even
# on a direct connection; set false only for a small speed gain on 5432.
SUPABASE_USE_POOLER=true

# Runs ALTER TABLE ... ENABLE ROW LEVEL SECURITY on tables this sync
# creates, so they are NOT readable via the project's public anon key.
# This sync connects as the database owner and bypasses RLS regardless.
SUPABASE_ENABLE_RLS=true

# Optional server-side statement timeout in milliseconds (0 = unlimited).
# Long backfill upserts can exceed a low value.
SUPABASE_STATEMENT_TIMEOUT_MS=0

# Comma-separated tables that should NOT get the _raw_json column (a full
# JSONB copy of each source record, alongside the typed columns that already
# hold the same values). It is ~1KB/row - about 90% of a wide row's on-disk
# size - so it is cheap at thousands of rows and ruinous at millions.
# Leave blank to keep it everywhere; "*" disables it for every table.
#
# ORDER MATTERS when switching an existing table: deploy this setting FIRST,
# then ALTER TABLE ... DROP COLUMN "_raw_json". Dropping first makes every
# upsert fail, because the INSERT still names the column.
SUPABASE_RAW_JSON_EXCLUDE_TABLES=*

# ---- Disk guard ----
# Refuse to write once the database passes STOP_PCT% of LIMIT_GB. Set
# LIMIT_GB to the project's disk size (Supabase > Settings > Compute and
# Disk) and update it whenever the disk is resized; 0 disables the guard.
SUPABASE_DISK_LIMIT_GB=50
SUPABASE_DISK_STOP_PCT=85

SUPABASE_POOL_SIZE=5
SUPABASE_MAX_OVERFLOW=5

# ---- Column naming ----
# false (default): keep BC's casing, e.g. "Posting_Date" - matches the
#   column names the old MySQL database used, so migrated data lines up.
#   Downside: queries must double-quote them.
# true: fold to lower case for idiomatic, quote-free Postgres identifiers.
# Decide once - flipping this later creates a SECOND set of columns.
PG_LOWERCASE_COLUMNS=false
